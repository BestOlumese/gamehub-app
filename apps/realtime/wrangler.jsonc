{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamehub-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "Room", "class_name": "GameRoom" },
      { "name": "Match", "class_name": "Matchmaker" },
      { "name": "Presence", "class_name": "Presence" },
    ],
  },
  // SQLite must be on in the FIRST migration; it can't be enabled later.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker", "Presence"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://gamehub-apps.vercel.app,http://localhost:3000",
    "WEB_ORIGIN": "https://gamehub-apps.vercel.app",
    // Seat hold after a disconnect before a bot takes over (docs/04-reconnection.md).
    "GRACE_MS": "60000",
  },
  // Secrets (wrangler secret put): REALTIME_TICKET_SECRET, INTERNAL_HMAC_SECRET, CHAT_SIGN_SECRET
}
