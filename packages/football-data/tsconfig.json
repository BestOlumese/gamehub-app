{
  "extends": "@gamehub/config/tsconfig/base.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // The CLI scripts run straight under Node 24 (type stripping): imports name their .ts files.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  }
}
