# ── apps/web/.env.local (local dev) ─────────────────────────────────────────
# With `pnpm services:up` running, these work as-is:
DATABASE_URL=postgres://gamehub:gamehub@localhost:5433/gamehub
SMTP_URL=smtp://localhost:1025          # Mailpit: read emails at http://localhost:8025
BETTER_AUTH_SECRET=                     # openssl rand -base64 48
# Turnstile and Google are optional locally (test keys are used; Google button hidden).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── packages/db/.env (migrations against Neon) ──────────────────────────────
# DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require

# ── Vercel → Project → Settings → Environment Variables (production) ────────
# DATABASE_URL, BETTER_AUTH_SECRET, GMAIL_USER, GMAIL_APP_PASSWORD,
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TURNSTILE_SECRET_KEY,
# NEXT_PUBLIC_TURNSTILE_SITE_KEY
