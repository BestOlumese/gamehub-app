# apps/web (.env.local) and packages/db (.env) — never commit real values.
# Neon → project → Connect → "Direct connection" string (not pooled) for migrations.
DATABASE_URL=

# Optional: public URL of the site (defaults to the Vercel production URL).
NEXT_PUBLIC_SITE_URL=
# Realtime Worker host: localhost:8787 in dev, gamehub-realtime.gamehub-app.workers.dev in prod.
NEXT_PUBLIC_REALTIME_HOST=localhost:8787
